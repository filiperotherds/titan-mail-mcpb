{
  "name": "titan-mail-mcp",
  "version": "1.0.0",
  "description": "MCP server to search, read and send email over IMAP/SMTP (Titan Mail by default)",
  "keywords": ["mcp", "model-context-protocol", "claude", "imap", "smtp", "email", "titan"],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "gen-token": "node dist/gen-token.js",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "author": "Filipe Rother",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filiperotherds/titan-mail-mcpb.git"
  },
  "homepage": "https://github.com/filiperotherds/titan-mail-mcpb#readme",
  "bugs": "https://github.com/filiperotherds/titan-mail-mcpb/issues",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "imapflow": "^2.2.8",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
